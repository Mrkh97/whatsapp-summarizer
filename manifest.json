{
  "manifest_version": 3,
  "name": "WhatsApp AI Summarizer",
  "description": "Summarize the currently open WhatsApp Web chat with OpenRouter.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["dist/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Summarize WhatsApp chat",
    "default_popup": "popup.html"
  }
}
